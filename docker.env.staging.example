# FIKA staging environment example.
# Copy to docker.env.staging and replace placeholders with staging-only values.
# Do not use production secrets, production databases, production Mercado Pago accounts,
# production Meta/GA4 IDs, or real SMTP credentials.

### Docker / network exposure
STAGING_APP_PORT=3100

### SQL Server staging database
STAGING_MSSQL_DATABASE=fikastore_staging_candidate
STAGING_MSSQL_SA_PASSWORD=<staging-sqlserver-sa-password>
STAGING_DATABASE_URL=sqlserver://staging-db:1433;database=fikastore_staging_candidate;user=sa;password=<staging-sqlserver-sa-password>;encrypt=true;trustServerCertificate=true

### Application URLs
STAGING_NEXTAUTH_URL=http://127.0.0.1:3100
STAGING_SITE_URL=http://127.0.0.1:3100
STAGING_PUBLIC_WEBHOOK_BASE_URL=

### NextAuth and encryption
STAGING_NEXTAUTH_SECRET=<staging-nextauth-secret>
STAGING_APP_SECRET_ENCRYPTION_KEY=<32-byte-staging-encryption-key>
STAGING_MAILING_ENCRYPTION_KEY=<32-byte-staging-mailing-encryption-key-or-empty>

### Mercado Pago sandbox / test credentials
# Use only Mercado Pago test credentials and test users from the staging/test app.
# Checkout Pro can use STAGING_MP_ACCESS_TOKEN.
# Checkout Transparente Orders API requires connecting the staging test seller via OAuth.
STAGING_ALLOW_MERCADOPAGO_SANDBOX=false
STAGING_MP_ACCESS_TOKEN=
STAGING_NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
STAGING_MP_OAUTH_CLIENT_ID=
STAGING_MP_OAUTH_CLIENT_SECRET=
STAGING_MP_OAUTH_SCOPES=read write offline_access
STAGING_MERCADOPAGO_DEBUG=true

### Mercado Pago webhooks
# Configure this URL in Mercado Pago Developers as the test webhook URL:
# ${STAGING_PUBLIC_WEBHOOK_BASE_URL}/api/webhooks/mercadopago
# Required topics for this validation: orders, payment, merchant_order.

### Meta Pixel and Conversions API
# Leave empty to disable real Meta Pixel/CAPI traffic.
# If testing CAPI, use a Meta test dataset/test event code only.
STAGING_ALLOW_TRACKING=false
STAGING_META_PIXEL_ID=
STAGING_META_CAPI_ACCESS_TOKEN=
STAGING_META_CAPI_TEST_EVENT_CODE=

### Google Analytics 4
# Leave empty to avoid loading GA4 in staging, or use a dedicated test property.
STAGING_NEXT_PUBLIC_GA_MEASUREMENT_ID=

### SMTP / email
# Leave empty for no real SMTP delivery. Use a mail sink only if explicitly validating emails.
STAGING_ALLOW_SMTP=false
STAGING_SMTP_HOST=
STAGING_SMTP_PORT=587
STAGING_SMTP_USER=
STAGING_SMTP_PASS=
STAGING_SMTP_FROM=
STAGING_SUPPORT_EMAIL=

### Cron jobs
# Cron services are intentionally not present in docker-compose.staging.yml,
# but the secrets must be set so protected endpoints do not become public.
STAGING_CRON_SECRET=<staging-cron-secret>
STAGING_INTERNAL_CRON_SECRET=<staging-internal-cron-secret>
STAGING_PENDING_ORDER_AUTO_CANCEL_HOURS=48
STAGING_CHATBOT_API_SECRET=

### Custom domains
STAGING_CUSTOM_DOMAIN_TARGET=
STAGING_CUSTOM_DOMAIN_SERVER_IP=
STAGING_CUSTOM_DOMAIN_BLOCKED_ROOT_DOMAINS=

### EPick shipping integration
# Leave credentials empty. Do not create real shipments from staging.
STAGING_ALLOW_SHIPPING_INTEGRATIONS=false
STAGING_EPICK_BASE_URL=
STAGING_EPICK_PHONE=
STAGING_EPICK_PASSWORD=
STAGING_EPICK_WEBHOOK_URL=
STAGING_EPICK_SENDER_NAME=
STAGING_EPICK_SENDER_PHONE=
STAGING_EPICK_SENDER_EMAIL=
STAGING_EPICK_SENDER_STREET=
STAGING_EPICK_SENDER_NUMBER=
STAGING_EPICK_SENDER_CITY=
STAGING_EPICK_SENDER_PROVINCE=
STAGING_EPICK_SENDER_POSTAL_CODE=
STAGING_EPICK_SENDER_EXTRA=
STAGING_EPICK_SENDER_INFO=
STAGING_EPICK_ADDRESSEE_PROVINCE=
STAGING_EPICK_PKG_LONG=30
STAGING_EPICK_PKG_WIDTH=20
STAGING_EPICK_PKG_HEIGHT=10
STAGING_EPICK_PKG_WEIGHT=1

### Correo Argentino integration
# Leave credentials empty. Do not create real shipments from staging.
STAGING_CORREO_ARG_DEBUG=0
STAGING_CORREO_ARG_BASE_URL=
STAGING_CORREO_ARG_ENV=qa
STAGING_CORREO_ARG_USER=
STAGING_CORREO_ARG_PASS=
STAGING_CORREO_ARG_CUSTOMER_ID=
STAGING_CORREO_ARG_POSTAL_ORIGIN=
STAGING_CORREO_ARG_PRODUCT_TYPE=
STAGING_CORREO_ARG_DELIVERY_TYPE=
STAGING_CORREO_ARG_PKG_WEIGHT_G=1000
STAGING_CORREO_ARG_PKG_HEIGHT_CM=10
STAGING_CORREO_ARG_PKG_WIDTH_CM=20
STAGING_CORREO_ARG_PKG_LENGTH_CM=30
